{
  "name": "scrubpix",
  "version": "0.1.0",
  "description": "See and strip hidden image metadata — EXIF, GPS location, camera info, comments — losslessly and 100% locally. No re-encoding, no upload. Zero dependencies; works in the browser, Node, Deno and Bun.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "build:web": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "exif",
    "metadata",
    "strip-exif",
    "remove-exif",
    "exif-remover",
    "gps",
    "privacy",
    "image-metadata",
    "png",
    "jpeg",
    "photo-privacy",
    "lossless",
    "zero-dependency"
  ],
  "author": "didrod205 (https://github.com/didrod205)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/didrod205/scrubpix.git"
  },
  "bugs": {
    "url": "https://github.com/didrod205/scrubpix/issues"
  },
  "homepage": "https://didrod205.github.io/scrubpix/",
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
